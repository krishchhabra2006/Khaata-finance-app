# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git.

# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults to claude-sonnet-5 if not set
CLAUDE_MODEL=claude-sonnet-5

# Optional — Elastic Beanstalk sets this automatically; EC2 defaults to 8080
PORT=8080
